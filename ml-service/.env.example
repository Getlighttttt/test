# Скопируйте в .env для запуска БЕЗ Docker (uvicorn локально)
DATABASE_URL=postgresql+psycopg://wms:wms123@localhost:5434/wms_analytics
# сколько секунд ждать, пока C# создаст свои таблицы в DB2 (0 — не ждать)
MAIN_SCHEMA_WAIT_SEC=90
MAIN_BACKEND_URL=http://localhost:5134
MAIN_BACKEND_ALERT_PATH=/api/ml/alerts
SERVICE_API_KEY=dev-ml-key
CRITICAL_THRESHOLD=0.70
HORIZON_MINUTES=60
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SEC=30
SIMULATOR_AUTO_REFILL=false
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
